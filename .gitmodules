[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "rformat"]
	path = rformat
	url = https://github.com/cornball-ai/rformat
[submodule "saber"]
	path = saber
	url = https://github.com/cornball-ai/saber
[submodule "whisper"]
	path = whisper
	url = https://github.com/cornball-ai/whisper
