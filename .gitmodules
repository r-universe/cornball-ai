[submodule ".registry"]
	path = .registry
	url = https://github.com/cornball-ai/cornball-ai.r-universe.dev
	branch = HEAD
[submodule "grpc"]
	path = grpc
	url = https://github.com/cornball-ai/grpc
[submodule "tinyoauth"]
	path = tinyoauth
	url = https://github.com/cornball-ai/tinyoauth
	registered = false
